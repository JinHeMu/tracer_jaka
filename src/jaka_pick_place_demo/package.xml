<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jaka_pick_place_demo</name>
  <version>0.0.1</version>
  <description>MoveIt2 pick &amp; place demo for tracer_jaka_zu5 (RViz / mock_components)</description>
  <maintainer email="you@todo.todo">you</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- 运行期依赖你的 moveit_config 包，名字如有不同请修改 -->
  <exec_depend>tracer_jaka_zu5_moveit_config</exec_depend>
  <exec_depend>jaka_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
